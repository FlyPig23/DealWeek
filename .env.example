# Prefer `weekly-deals auth jev`: prompts privately, verifies the key, then
# saves ~/.config/weekly-deals/.env (or $XDG_CONFIG_HOME/weekly-deals/.env).
# Shell variables and this project-local .env override that user configuration.
# Never put keys in config.yaml, SKILL.md or source control.

# --- JEV / TypeSafe classifier -------------------------------------------
# Optional in agent-host mode and in fully local classification.mode=off runs.
# TYPESAFE_API_KEY=your-own-key
# TYPESAFE_EMAIL_PROCESSING_CONSENT=true  # official TypeSafe endpoint only
# Use the current official alias, or pin a version for an evaluation.
JEV_MODEL=jev-latest
JEV_ENDPOINT=https://api.typesafe.ai/v1/systemone

# --- LLM extractor --------------------------------------------------------
# mock       = offline rule engine, no key needed, used by `demo`
# openai     = native structured outputs
# compatible = any OpenAI-shaped endpoint; capabilities are NOT assumed
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
# Setting this changes WHO RECEIVES YOUR EMAIL TEXT. Re-confirm consent when
# you change it.
LLM_BASE_URL=

# --- Mailbox --------------------------------------------------------------
# fixtures | gmail_api | gmail_mcp (not implemented in v0.1)
MAIL_PROVIDER=fixtures
# Path to the OAuth client config you downloaded from Google Cloud.
# Never copy someone else's.
GMAIL_CLIENT_SECRET_PATH=

# --- Local paths and display ---------------------------------------------
WEEKLY_DEALS_DATA_DIR=
WEEKLY_DEALS_TIMEZONE=America/Chicago
WEEKLY_DEALS_LANGUAGE=zh-CN
