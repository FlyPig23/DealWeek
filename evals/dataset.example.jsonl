// Example gold set. Synthetic, tiny, and deliberately weighted towards the
// cases that break naive implementations. A real set needs 200-500 rows of
// your own authorised mail; keep it out of git (see .gitignore: evals/private/).
// `group` keeps every email of one campaign in the same fold.
{"id": "e001", "group": "noodle-lunch", "subject": "Lunch bowls: $4 off through Sunday", "body": "Take $4 off any lunch bowl when you spend $12 or more. Offer ends September 30, 2026. Pickup only.", "contains_food_offer": true, "offer_count": 1, "note": "plain positive"}
{"id": "e002", "group": "noodle-lunch", "subject": "Reminder: your lunch credit ends Sunday", "body": "Don't forget: $4 off any lunch bowl with a $12 minimum. Offer ends September 30, 2026.", "contains_food_offer": true, "offer_count": 1, "note": "same campaign as e001 -- must not split across folds"}
{"id": "e003", "group": "stonebridge-menu", "subject": "Introducing our new autumn menu", "body": "Our autumn menu is here, featuring roasted squash soup. Come try it at any of our four locations.", "contains_food_offer": false, "offer_count": 0, "note": "announcement, no benefit -- the classic false positive"}
