{"id": "e005", "group": "greenfork-status", "subject": "Your order is on the way", "body": "Your driver is 5 minutes away. Track your order in the app.", "contains_food_offer": false, "offer_count": 0, "note": "order status only -- must not be excluded by a blanket receipt rule"}
