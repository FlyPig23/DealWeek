{"id": "e007", "group": "harbor-pastry", "subject": "Members: free pastry with any drink", "body": "Rewards members get a free pastry with any drink purchase. Show your member code at the counter.", "contains_food_offer": true, "offer_count": 1, "note": "no end date -- must not become 'never expires'"}
